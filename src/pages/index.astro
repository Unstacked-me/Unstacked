---
import Layout from '../layouts/Layout.astro';

const focusRing = 'focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white';

// Topic cards under the headline. Links point at the closest Unstack Me page for now.
const cards = [
	{ label: 'Home Ownership', href: '/unstackme/home-ownership', icon: 'home' },
	{ label: 'Reducing debt', href: '/unstackme/bad-debt', icon: 'debt' },
	// "Investing" is still coming soon, so this points at Pension matching for now.
	{ label: 'Growing Wealth', href: '/unstackme/pension-matching', icon: 'wealth' },
] as const;

// Filled white icons (24×24).
const cardIcons = {
	home: 'M12 3 2.5 11h2.5v9.5h5.25V15h3.5v5.5H19V11h2.5L12 3Zm3.75 1.6V7l2.5 2.1V4.6h-2.5Z',
	debt: 'M4 5h16a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2Zm0 3.2V9l8 4.8L20 9v-.8l-8 4.6-8-4.6Zm4.2 6.3-1.4 1.4 2.2 2.2 4.2-4.2-1.4-1.4-2.8 2.8-.8-.8Z',
	wealth:
		'M19.5 10.2c-.6-2.9-3.6-5-7.3-5-1.2 0-2.4.2-3.4.7L6.6 4.5v3.1C5.3 8.6 4.5 10 4.4 11.5H2.6v3.3h2.2c.6 1.4 1.7 2.5 3.1 3.2v2.3h3.2v-1.6h2.4v1.6h3.2v-2.5c1.6-.9 2.7-2.4 3-4.2h1.7v-3.4h-1.9Zm-3.7 1.6a1 1 0 1 1 0-2 1 1 0 0 1 0 2Zm-6.4-3.4h4.8v1.4H9.4V8.4Z',
} as const;
---

<Layout title="Unstacked">
	<section class="relative isolate overflow-hidden bg-[#231f20] text-[#f5f5f5]">
		<!-- Generated background: tumbling stacks of blocks in greys and purples, with soft purple glows -->
		<div class="absolute inset-0 -z-10" aria-hidden="true">
			<svg class="absolute inset-0 size-full" preserveAspectRatio="xMidYMid slice">
				<defs>
					<pattern id="stacks" width="180" height="150" patternUnits="userSpaceOnUse">
						<!-- tall grey stack -->
						<g fill="#3f3f46" fill-opacity="0.55">
							<rect x="14" y="96" width="34" height="9" rx="3" />
							<rect x="14" y="84" width="34" height="9" rx="3" />
							<rect x="14" y="72" width="34" height="9" rx="3" />
							<rect x="16" y="60" width="34" height="9" rx="3" transform="rotate(-6 33 64)" />
						</g>
						<!-- purple stack with a block sliding off -->
						<g fill="#3f0472" fill-opacity="0.7">
							<rect x="78" y="120" width="34" height="9" rx="3" />
							<rect x="78" y="108" width="34" height="9" rx="3" />
							<rect x="88" y="92" width="34" height="9" rx="3" transform="rotate(14 105 96)" />
						</g>
						<!-- small bright accent block, mid-fall -->
						<rect x="136" y="40" width="22" height="7" rx="2.5" fill="#8d00f2" fill-opacity="0.35" transform="rotate(-24 147 43)" />
						<!-- low grey stack -->
						<g fill="#2e2a2b">
							<rect x="120" y="134" width="34" height="9" rx="3" />
							<rect x="122" y="122" width="34" height="9" rx="3" transform="rotate(4 139 126)" />
						</g>
						<!-- loose dark-purple block -->
						<rect x="52" y="20" width="28" height="8" rx="3" fill="#3f0472" fill-opacity="0.45" transform="rotate(32 66 24)" />
					</pattern>
					<radialGradient id="glow-left" cx="12%" cy="88%" r="55%">
						<stop offset="0" stop-color="#8d00f2" stop-opacity="0.35" />
						<stop offset="1" stop-color="#8d00f2" stop-opacity="0" />
					</radialGradient>
					<radialGradient id="glow-right" cx="90%" cy="8%" r="50%">
						<stop offset="0" stop-color="#3f0472" stop-opacity="0.55" />
						<stop offset="1" stop-color="#3f0472" stop-opacity="0" />
					</radialGradient>
					<!-- darken the middle so the headline stays readable -->
					<radialGradient id="centre-fade" cx="50%" cy="42%" r="45%">
						<stop offset="0" stop-color="#231f20" stop-opacity="0.92" />
						<stop offset="1" stop-color="#231f20" stop-opacity="0" />
					</radialGradient>
				</defs>
				<rect width="100%" height="100%" fill="url(#stacks)" />
				<rect width="100%" height="100%" fill="url(#glow-left)" />
				<rect width="100%" height="100%" fill="url(#glow-right)" />
				<rect width="100%" height="100%" fill="url(#centre-fade)" />
			</svg>
		</div>

		<div class="mx-auto flex min-h-[calc(100dvh-4rem)] max-w-5xl flex-col items-center justify-center px-6 py-20 text-center lg:min-h-[calc(100dvh-3.5rem)]">
			<h1 class="max-w-2xl text-4xl leading-tight font-normal text-balance sm:text-5xl">
				Tired of feeling like the odds are stacked against you?
			</h1>

			<a
				href="/unstackme"
				class={`mt-10 inline-flex items-center rounded-ui border border-white/80 bg-accent px-5 py-2 text-xs font-semibold text-white ${focusRing}`}
			>
				Get Unstacked
			</a>

			<!-- Topic cards: swipe on touch, arrows to scroll -->
			<div class="mt-20 flex w-full max-w-md items-center gap-2 sm:max-w-lg" data-card-carousel>
				<button
					type="button"
					class={`grid size-8 shrink-0 place-items-center rounded-ui transition-opacity disabled:opacity-30 ${focusRing}`}
					aria-label="Previous"
					data-card-scroll="-1"
				>
					<svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
						<path d="m15 6-6 6 6 6" />
					</svg>
				</button>

				<ul class="flex flex-1 snap-x snap-mandatory gap-3 overflow-x-auto py-1 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden" data-card-track>
					{
						cards.map((card) => (
							<li class="w-[calc((100%-1.5rem)/3)] min-w-28 shrink-0 snap-start">
								<a
									href={card.href}
									class={`flex aspect-[5/4] flex-col items-center justify-center gap-2 rounded-ui border-2 border-brand bg-gradient-to-r from-accent to-[#160a2e] px-2 text-center text-sm leading-tight text-white ${focusRing}`}
								>
									<svg class="size-6" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
										<path d={cardIcons[card.icon]} fill-rule="evenodd" />
									</svg>
									{card.label}
								</a>
							</li>
						))
					}
				</ul>

				<button
					type="button"
					class={`grid size-8 shrink-0 place-items-center rounded-ui transition-opacity disabled:opacity-30 ${focusRing}`}
					aria-label="Next"
					data-card-scroll="1"
				>
					<svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
						<path d="m9 6 6 6-6 6" />
					</svg>
				</button>
			</div>
		</div>
	</section>
</Layout>

<script>
	// Arrows scroll the cards one at a time; each dims when there's nothing more that way.
	for (const carousel of document.querySelectorAll<HTMLElement>('[data-card-carousel]')) {
		const track = carousel.querySelector<HTMLElement>('[data-card-track]')!;
		const buttons = [...carousel.querySelectorAll<HTMLButtonElement>('[data-card-scroll]')];

		const update = () => {
			const max = track.scrollWidth - track.clientWidth;
			for (const button of buttons) {
				const dir = Number(button.dataset.cardScroll);
				button.disabled = dir < 0 ? track.scrollLeft <= 2 : track.scrollLeft >= max - 2;
			}
		};

		for (const button of buttons) {
			button.addEventListener('click', () => {
				const card = track.firstElementChild as HTMLElement | null;
				const step = (card?.offsetWidth ?? 120) + 12;
				track.scrollBy({ left: Number(button.dataset.cardScroll) * step, behavior: 'smooth' });
			});
		}
		track.addEventListener('scroll', update, { passive: true });
		window.addEventListener('resize', update);
		update();
	}
</script>
