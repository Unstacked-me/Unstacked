---
/**
 * One page per Unstack Me sidebar item: /unstackme/<slug>.
 * Placeholder for now (sidebar only, empty content); give a topic its own
 * content by adding src/pages/unstackme/<slug>.astro, which takes priority.
 */
import Layout from '../../layouts/Layout.astro';
import Sidebar from '../../components/Sidebar.astro';
import { unstackMeSidebar } from '../../data/unstackMe';

export function getStaticPaths() {
	// Topics that already have their own page file (e.g. budgeting.astro) are skipped here.
	const ownPages = Object.keys(import.meta.glob('./*.astro'))
		.map((file) => file.replace(/^\.\/(.*)\.astro$/, '$1'))
		.filter((name) => !name.startsWith('['));

	return unstackMeSidebar
		.flatMap((section) => section.items)
		.filter((item) => !item.comingSoon && !ownPages.includes(item.slug))
		.map((item) => ({ params: { slug: item.slug }, props: { label: item.label } }));
}

const { slug } = Astro.params;
const { label } = Astro.props;
---

<Layout title={`${label} · Unstack Me`}>
	<Sidebar
		slot="sidebar"
		sections={unstackMeSidebar}
		label="Unstack Me"
		basePath="/unstackme"
		current={slug}
	/>
</Layout>
