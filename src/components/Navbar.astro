---
import { icons, type Icon } from '../data/icons';
/**
 * Site navbar, built from the desktop and mobile light/dark wireframes.
 * Edit `menus` to change the dropdowns; the links below are placeholders.
 *
 * Any button with `data-toggle` + `aria-controls` opens/closes the element with
 * that id (adds the `open` class). Only one is open at a time.
 */
interface Menu {
	label: string;
	icon: Icon;
	/** Plain link (no drop-down). */
	href?: string;
	/** Drop-down links (desktop), used when there's no `href`. */
	links?: { label: string; href: string }[];
}

const menus: Menu[] = [
	{
		label: 'Personal Goals',
		icon: 'goals',
		href: '/personalgoals',
	},
	{
		label: 'Information',
		icon: 'info',
		links: [
			{ label: 'Guides', href: '/information/guides' },
			{ label: 'Glossary', href: '/information/glossary' },
			{ label: 'FAQs', href: '/information/faqs' },
		],
	},
	{
		label: 'Downloadables',
		icon: 'download',
		links: [
			{ label: 'Templates', href: '/downloads/templates' },
			{ label: 'Worksheets', href: '/downloads/worksheets' },
		],
	},
	{
		label: 'Articles',
		icon: 'article',
		links: [
			{ label: 'Latest', href: '/articles' },
			{ label: 'Popular', href: '/articles/popular' },
		],
	},
];

// A link menu is "current" on its own page and everything under it.
const path = Astro.url.pathname.replace(/\/$/, '');
const isCurrent = (menu: Menu) => !!menu.href && (path === menu.href || path.startsWith(`${menu.href}/`));

const focusRing = 'focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand';

// Icons: brand gradient in light mode; plain colour in dark mode or on a selected (gradient) item.
const icon = 'icon-gradient dark:stroke-current group-data-active:stroke-current';

// Light mode: gradient border. Dark mode: solid #3f3f46 border.
const gradientBorder = 'border border-gradient dark:border-line dark:bg-none dark:bg-layer-2';

// Desktop menu buttons: #f5f5f5 fill in light mode (layer 1, same as the navbar).
const pill = `inline-flex h-9 items-center gap-1 rounded-ui ${gradientBorder} [--fill:var(--layer-1)] px-3 text-sm font-semibold text-ink ${focusRing}`;

// Light shadow used to lift the navbar and search panel off the page (no borders).
const softShadow = 'shadow-[0_4px_12px_rgb(0_0_0/0.12)] dark:shadow-[0_4px_12px_rgb(0_0_0/0.7)]';

// Mobile tab/search button. The item under the sliding highlight (data-active) turns white.
const mobileItem =
	'group relative flex h-full items-center justify-center rounded-ui transition-colors duration-300 data-active:text-white focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-brand';

// Panels that slide out from under the navbar (mobile search, desktop drop-downs).
// Brand gradient at 20% over #f5f5f5 in light mode, layer 2 in dark; no border, soft shadow.
// Each sits in a clipping strip just below the navbar and slides down when `.open` is set on the strip.
// Opening shows it instantly (so focus can move into it); closing keeps it visible until the slide finishes.
const slidePanel = `pointer-events-auto invisible -translate-y-full rounded-b-ui bg-layer-1 bg-gradient-to-r from-brand/20 to-brand-deep/20 ${softShadow} dark:bg-layer-2 dark:from-layer-2 dark:to-layer-2 transition-[translate,visibility] duration-300 ease-out motion-reduce:transition-none [.open>&]:visible [.open>&]:translate-y-0 [.open>&]:transition-[translate]`;

// Search drop-down on mobile: under the whole nav bar, 80% wide.
const searchPanel = `${slidePanel} mx-auto w-4/5 p-3`;

// Desktop menu drop-down, under its button.
const menuPanel = `${slidePanel} flex w-max min-w-44 flex-col p-1`;
---

<header class={`sticky top-0 z-50 bg-layer-1 ${softShadow}`}>
	<!-- Gradient used by `icon-gradient` (see global.css) -->
	<svg class="absolute size-0" aria-hidden="true" focusable="false">
		<linearGradient id="brand-gradient" x1="0" y1="0" x2="1" y2="0">
			<stop offset="0" style="stop-color: var(--brand)" />
			<stop offset="1" style="stop-color: var(--brand-deep)" />
		</linearGradient>
	</svg>

	<!-- ───────────── Mobile (< lg) ───────────── -->
	<!--
		Three columns: logo | tabs (centred) | search (right-aligned).
		The tab bar spans the last two columns, so its background starts at the
		first tab and runs to the right edge behind the search button.
	-->
	<nav class="relative grid h-16 grid-cols-[1fr_auto_1fr] items-center gap-1 px-2.5 lg:hidden" aria-label="Main">
		<a href="/" class={`justify-self-start rounded-ui text-brand ${focusRing}`} aria-label="Home">
			<svg class={`size-7 ${icon}`} viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
				<path d="M2 9V2h7M23 2h7v7M30 23v7h-7M9 30H2v-7" />
			</svg>
		</a>

		<div class={`relative col-span-2 grid h-12 grid-cols-subgrid overflow-hidden rounded-ui border border-gradient-tinted dark:border-line dark:bg-none dark:bg-layer-2`}>
			<!-- Sliding highlight: moved under the selected tab (or the search button while search is open) by the script below -->
			<span
				class="pointer-events-none absolute inset-y-0 left-0 isolate overflow-hidden rounded-ui opacity-0 transition-[translate,width,opacity] duration-300 ease-out motion-reduce:transition-none dark:bg-line"
				aria-hidden="true"
				data-tab-indicator
			>
				<span class="spin-layer dark:hidden" data-spin-layer></span>
			</span>
			<ul class="flex h-full">
				{
					menus.map((menu) => {
						const Tab = menu.href ? 'a' : 'button';
						return (
						<li>
							<Tab
								href={menu.href}
								type={menu.href ? undefined : 'button'}
								class={`flex-col gap-0.5 px-[7px] py-1 text-[10px] min-[390px]:px-2 min-[412px]:px-2.5 max-[374px]:px-1 max-[374px]:text-[9px] font-semibold leading-tight whitespace-nowrap text-ink ${mobileItem}`}
								aria-pressed={menu.href ? undefined : 'false'}
								aria-current={isCurrent(menu) ? 'page' : undefined}
								data-tab
							>
								<svg
									class={`size-5 ${icon}`}
									viewBox="0 0 24 24"
									fill="none"
									stroke="currentColor"
									stroke-width="1.8"
									stroke-linecap="round"
									stroke-linejoin="round"
									aria-hidden="true"
								>
									<path d={icons[menu.icon]} />
								</svg>
								{menu.label}
							</Tab>
						</li>
						);
					})
				}
			</ul>

			<button
				type="button"
				class={`w-9 justify-self-end text-ink ${mobileItem}`}
				aria-label="Search"
				aria-expanded="false"
				aria-controls="m-search"
				data-toggle
			>
				<svg class={`size-5 ${icon}`} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" aria-hidden="true">
					<circle cx="10.5" cy="10.5" r="6.5" />
					<path d="m15.5 15.5 5 5" stroke-linecap="round" />
				</svg>
			</button>
		</div>

		<!-- Clipping strip directly under the navbar (extra bottom padding leaves room for the panel's shadow) -->
		<div id="m-search" class="pointer-events-none absolute inset-x-0 top-full overflow-hidden pb-6">
			<form action="/search" method="get" role="search" class={searchPanel}>
				<label for="m-search-input" class="sr-only">Search</label>
				<input
					id="m-search-input"
					name="q"
					type="search"
					placeholder="What are you looking for?"
					class="w-full rounded-ui border-0 bg-layer-2 px-4 py-2 text-sm text-ink outline-none placeholder:text-ink/60 dark:bg-line"
				/>
			</form>
		</div>
	</nav>

	<!-- ───────────── Desktop (lg+) ───────────── -->
	<nav class="mx-auto hidden h-14 max-w-7xl items-center gap-4 px-4 lg:flex" aria-label="Main">
		<a href="/" class={`shrink-0 rounded-ui text-brand ${focusRing}`} aria-label="Home">
			<svg class={`size-8 ${icon}`} viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
				<path d="M2 9V2h7M23 2h7v7M30 23v7h-7M9 30H2v-7" />
			</svg>
		</a>

		<ul class="flex items-center gap-2 self-stretch">
			{
				menus.map((menu, i) => menu.href ? (
					<li class="relative flex h-full items-center">
						<a href={menu.href} class={pill} aria-current={isCurrent(menu) ? 'page' : undefined}>
							{menu.label}
						</a>
					</li>
				) : (
					<li class="relative flex h-full items-center">
						<button type="button" class={pill} aria-expanded="false" aria-controls={`d-menu-${i}`} data-toggle>
							{menu.label}
							<svg
								class={`size-4 transition-transform [[aria-expanded=true]>&]:rotate-180 ${icon}`}
								viewBox="0 0 24 24"
								fill="none"
								stroke="currentColor"
								stroke-width="2.5"
								aria-hidden="true"
							>
								<path d="m6 9 6 6 6-6" />
							</svg>
						</button>
						<!-- Clipping strip under the navbar (padding leaves room for the shadow) -->
						<div id={`d-menu-${i}`} class="pointer-events-none absolute -left-6 top-full overflow-hidden px-6 pb-6">
							<ul class={menuPanel}>
								{menu.links?.map((link) => (
									<li>
										<a href={link.href} class="block rounded-ui px-3 py-2 text-sm text-ink">
											{link.label}
										</a>
									</li>
								))}
							</ul>
						</div>
					</li>
				))
			}
		</ul>

		<form action="/search" method="get" role="search" class="relative max-w-md flex-1">
			<label for="d-search-input" class="sr-only">Search</label>
			<input
				id="d-search-input"
				name="q"
				type="search"
				placeholder="What are you looking for?"
				class={`h-9 w-full rounded-ui ${gradientBorder} [--fill:var(--layer-1)] pl-4 pr-10 text-sm text-ink placeholder:text-ink/60 focus:outline-none focus:ring-2 focus:ring-brand/30`}
			/>
			<button
				type="submit"
				class="absolute right-1 top-1/2 inline-flex size-8 -translate-y-1/2 items-center justify-center rounded-ui text-ink"
				aria-label="Search"
			>
				<svg class={`size-4 ${icon}`} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" aria-hidden="true">
					<circle cx="10.5" cy="10.5" r="6.5" />
					<path d="m15.5 15.5 5 5" stroke-linecap="round" />
				</svg>
			</button>
		</form>

		<div class="ml-auto flex items-center gap-4">
			<a
				href="/how-to-use"
				class={`relative isolate inline-flex h-9 items-center overflow-hidden rounded-ui px-6 text-sm font-semibold text-white shadow-sm ${focusRing}`}
				data-spin-on-hover
			>
				<span class="spin-layer" aria-hidden="true" data-spin-layer></span>
				How to use
			</a>

			<button type="button" class={`rounded-ui ${focusRing}`} aria-label="Language: English (UK)">
				<svg class="h-4 w-8" viewBox="0 0 60 30" aria-hidden="true">
					<clipPath id="uk-s"><path d="M0,0 v30 h60 v-30 z" /></clipPath>
					<clipPath id="uk-t"><path d="M30,15 h30 v15 z v15 h-30 z h-30 v-15 z v-15 h30 z" /></clipPath>
					<g clip-path="url(#uk-s)">
						<path d="M0,0 v30 h60 v-30 z" fill="#012169" />
						<path d="M0,0 L60,30 M60,0 L0,30" stroke="#fff" stroke-width="6" />
						<path d="M0,0 L60,30 M60,0 L0,30" clip-path="url(#uk-t)" stroke="#C8102E" stroke-width="4" />
						<path d="M30,0 v30 M0,15 h60" stroke="#fff" stroke-width="10" />
						<path d="M30,0 v30 M0,15 h60" stroke="#C8102E" stroke-width="6" />
					</g>
				</svg>
			</button>
		</div>
	</nav>
</header>

<script>
	const toggles = [...document.querySelectorAll<HTMLElement>('[data-toggle]')];
	const panelFor = (t: HTMLElement) => document.getElementById(t.getAttribute('aria-controls')!);

	// ── Spinning gradient ──
	// Turns a `[data-spin-layer]` at a steady speed. Stopping lets it finish the
	// current turn so it always comes to rest at the plain left → right gradient.
	const SPIN_MS = 4000;
	const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
	const spins = new WeakMap<Element, Animation>();

	function spin(layer: Element | null | undefined, on: boolean) {
		if (!layer) return;
		let anim = spins.get(layer);
		if (on) {
			if (reduceMotion.matches) return;
			if (anim && anim.playState !== 'finished') {
				anim.onfinish = null;
				anim.effect?.updateTiming({ iterations: Infinity });
				return;
			}
			anim = layer.animate([{ rotate: '0deg' }, { rotate: '360deg' }], {
				duration: SPIN_MS,
				iterations: Infinity,
			});
			spins.set(layer, anim);
		} else if (anim) {
			const elapsed = Number(anim.currentTime ?? 0);
			anim.effect?.updateTiming({ iterations: Math.floor(elapsed / SPIN_MS) + 1 });
			anim.onfinish = () => {
				anim!.cancel();
				spins.delete(layer);
			};
		}
	}

	for (const el of document.querySelectorAll<HTMLElement>('[data-spin-on-hover]')) {
		const layer = el.querySelector('[data-spin-layer]');
		el.addEventListener('pointerenter', () => spin(layer, true));
		el.addEventListener('pointerleave', () => spin(layer, false));
	}

	// ── Mobile tab bar ──
	// One sliding highlight sits under the selected tab. While search is open it
	// slides to the search button, then slides back (or fades out) when search closes.
	const tabs = [...document.querySelectorAll<HTMLElement>('[data-tab]')];
	const mobileSearch = document.querySelector<HTMLElement>('[aria-controls="m-search"]');
	const indicator = document.querySelector<HTMLElement>('[data-tab-indicator]');
	let selected: HTMLElement | null = null;
	let searchOpen = false;

	// Move the highlight under `target`; fade it in in place if it was hidden, fade out for null.
	function moveIndicator(target: HTMLElement | null, animate = true) {
		if (!indicator) return;
		for (const el of [...tabs, mobileSearch]) el?.toggleAttribute('data-active', el === target);
		spin(indicator.querySelector('[data-spin-layer]'), !!target); // spins while something is selected
		if (!target) {
			indicator.style.opacity = '0';
			return;
		}
		const appearing = indicator.style.opacity !== '1';
		if (appearing || !animate) indicator.style.transitionProperty = 'opacity';
		indicator.style.width = `${target.offsetWidth}px`;
		indicator.style.translate = `${target.offsetLeft}px 0`;
		indicator.getBoundingClientRect(); // commit position before re-enabling the slide
		indicator.style.transitionProperty = '';
		indicator.style.opacity = '1';
	}

	const updateIndicator = (animate = true) => moveIndicator(searchOpen ? mobileSearch : selected, animate);

	function selectTab(tab: HTMLElement | null) {
		selected = tab;
		for (const t of tabs) t.setAttribute('aria-pressed', String(t === tab));
		updateIndicator();
	}

	for (const tab of tabs) {
		// Link tabs just navigate (the highlight slides to them first); button tabs toggle.
		tab.addEventListener('click', () => selectTab(tab instanceof HTMLAnchorElement || tab !== selected ? tab : null));
	}

	// On a section's pages (e.g. /personalgoals/...), start with its tab selected, without animating.
	const currentTab = tabs.find((t) => t.getAttribute('aria-current') === 'page');
	if (currentTab && indicator) {
		indicator.style.transition = 'none';
		selectTab(currentTab);
		indicator.getBoundingClientRect();
		indicator.style.transition = '';
	}

	// Tab widths change with the viewport (e.g. smaller labels under 375px).
	window.addEventListener('resize', () => updateIndicator(false));

	// ── Toggles (desktop drop-downs, mobile search) ──
	function setOpen(toggle: HTMLElement, open: boolean) {
		toggle.setAttribute('aria-expanded', String(open));
		panelFor(toggle)?.classList.toggle('open', open);
		if (toggle === mobileSearch && open !== searchOpen) {
			searchOpen = open;
			updateIndicator();
		}
	}

	function closeAll(except?: HTMLElement) {
		for (const t of toggles) if (t !== except) setOpen(t, false);
	}

	for (const toggle of toggles) {
		toggle.addEventListener('click', () => {
			const open = toggle.getAttribute('aria-expanded') !== 'true';
			closeAll(toggle);
			setOpen(toggle, open);
			if (open) panelFor(toggle)?.querySelector<HTMLElement>('input, a')?.focus();
		});
	}

	// Close on outside click (clicks inside a toggle or an open panel are ignored).
	document.addEventListener('click', (e) => {
		const target = e.target as Element;
		if (target.closest('[data-toggle], .open')) return;
		closeAll();
	});

	document.addEventListener('keydown', (e) => {
		if (e.key !== 'Escape') return;
		const openToggle = toggles.find((t) => t.getAttribute('aria-expanded') === 'true');
		closeAll();
		openToggle?.focus();
	});
</script>
