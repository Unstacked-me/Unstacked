---
// Google Fonts, self-hosted via Fontsource (no requests to Google). Font files only
// download on pages that use them.
import '@fontsource-variable/plus-jakarta-sans'; // body / UI
import '@fontsource-variable/fraunces'; // display headings
import '@fontsource/kaushan-script'; // script accent
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';

interface Props {
	title?: string;
}

const { title = 'Finance Site' } = Astro.props;
const hasSidebar = Astro.slots.has('sidebar');
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body class="min-h-screen">
		<Navbar />
		<!--
			Pages can pass a sidebar with slot="sidebar". On desktop the sidebar colour
			frames the content: a thin strip runs along the top and the #efefef content
			area tucks into it with a rounded corner (outlined in #3f3f46 in dark mode).
			On mobile the sidebar becomes a floating bar at the bottom of the screen.
		-->
		{
			hasSidebar ? (
				<div class="lg:flex lg:bg-sidebar">
					<slot name="sidebar" />
					<!-- Mobile: plain content area, with room at the bottom for the floating page bar -->
					<main class="min-h-[calc(100dvh-4rem)] min-w-0 flex-1 bg-content pb-28 lg:mt-2.5 lg:min-h-[calc(100dvh-3.5rem-0.625rem)] lg:rounded-tl-ui lg:pb-0 dark:lg:border-l dark:lg:border-t dark:lg:border-line">
						<slot />
					</main>
				</div>
			) : (
				<main>
					<slot />
				</main>
			)
		}
	</body>
</html>
